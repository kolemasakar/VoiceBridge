{
  "manifest_version": 3,
  "name": "VoiceBridge",
  "description": "Real-time cloud speech translation for audio playing in the active browser tab, with translated speech playback and automatic ducking.",
  "version": "0.8.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://voicebridge-cloud-us.onrender.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "VoiceBridge",
    "default_popup": "popup.html"
  }
}
