HOST=0.0.0.0
PORT=8080
TEST_ACCESS_TOKEN=replace-with-a-long-random-test-token
STT_PROVIDER=gemini
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
ASSEMBLYAI_API_KEY=replace-with-an-assemblyai-api-key
ASSEMBLYAI_SPEECH_MODEL=universal-streaming-english
GEMINI_API_KEY=
TRANSLATION_PROVIDER=azure
TRANSLATION_FALLBACK_PROVIDER=gemini
GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_TTS_VOICE=uk-UA-OstapNeural
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Iapetus
CORS_ALLOWED_ORIGIN=*
MAX_REQUEST_BODY_BYTES=32768
RATE_LIMIT_REQUESTS_PER_MINUTE=120
